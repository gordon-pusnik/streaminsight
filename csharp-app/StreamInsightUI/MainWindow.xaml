<Window x:Class="StreamInsightUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StreamInsight Video Analyzer" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Health Section -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="API Status: " VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBlock x:Name="HealthStatusText" Text="Unknown" VerticalAlignment="Center" Foreground="Gray" Margin="5,0,0,0"/>
            <Button Content="Check Health" Margin="15,0,0,0" Padding="10,2" Click="CheckHealth_Click"/>
        </StackPanel>

        <!-- File Selection Section -->
        <GroupBox Grid.Row="1" Header="Video Selection" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilePathTextBox" IsReadOnly="True" VerticalAlignment="Center" Margin="0,0,5,0" Text="Select a video file..."/>
                <Button Grid.Column="1" Content="Browse..." Padding="10,2" Click="Browse_Click"/>
            </Grid>
        </GroupBox>

        <!-- Engine Selection Section -->
        <GroupBox Grid.Row="2" Header="AI Engine Selection" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <RadioButton x:Name="OpenAIRadioButton" Content="OpenAI" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <RadioButton x:Name="VertexAIRadioButton" Content="Vertex AI" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <!-- Actions Section -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AnalyzeButton" Content="Analyze Video" Padding="20,5" IsEnabled="False" Click="Analyze_Click" FontWeight="Bold"/>
            <ProgressBar x:Name="AnalysisProgressBar" Width="200" Height="20" Margin="20,0,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Blue"/>
        </StackPanel>

        <!-- Results Section -->
        <GroupBox Grid.Row="4" Header="Analysis Results">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ResultsTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" FontFamily="Consolas"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Footer -->
        <StatusBar Grid.Row="5" Margin="-10,5,-10,-10">
            <StatusBarItem>
                <TextBlock x:Name="FooterStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
